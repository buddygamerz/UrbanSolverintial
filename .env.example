# UrbanSolver Environment Variables

# Backend (FastAPI)
# Database connection
DATABASE_URL=postgresql://postgres:postgres@db:5432/urbansolver

# Redis cache
REDIS_URL=redis://redis:6379/0

# JWT secret (for auth)
JWT_SECRET=change_me_very_secret

# AI model configuration
# Default model provider (openai compatible)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder

# Ollama endpoint (for local models)
OLLAMA_HOST=http://ollama:11434

# Model selection (can be overridden per endpoint)
# Example: SMALL_MODEL=ollama/nvidia-nemotron-3-nano
# MEDIUM_MODEL=ollama/nvidia-nemotron-3-medium
# LARGE_MODEL=ollama/nvidia-nemotron-3-30b

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Enable/disable features
ENABLE_AI_ANALYSIS=true
ENABLE_NOTIFICATIONS=true

# For production
# Use SSL termination at reverse proxy
# SESSION_COOKIE_SECURE=true
# CSRF_ENABLED=true